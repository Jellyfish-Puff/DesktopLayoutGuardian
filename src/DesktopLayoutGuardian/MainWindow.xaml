<Window x:Class="DesktopLayoutGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面布局 - 显示环境保护"
        Width="1120"
        Height="740"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="14,20,14,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="32" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8,0">
          <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="&#xECA5;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="桌面布局" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="显示环境保护 · v0.4" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <Button x:Name="CurrentEnvironmentNavButton" Style="{StaticResource NavButtonStyle}" Background="{StaticResource PrimarySoftBrush}" Foreground="{StaticResource PrimaryBrush}" Click="NavigateCurrent_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="29" />
              <TextBlock Text="当前环境" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ProfilesNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateProfiles_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="29" />
              <TextBlock Text="显示方案" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="HistoryNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateHistory_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="29" />
              <TextBlock Text="恢复记录" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Row="3" Padding="11" CornerRadius="10" Background="#DFF5EB">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
            <StackPanel Margin="9,0,0,0">
              <TextBlock Text="后台保护已开启" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
              <TextBlock Text="仅恢复已保存的方案" FontSize="11" Foreground="#477363" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="CurrentEnvironmentPanel" Grid.Column="1" Margin="30,25,32,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="当前显示环境" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="显示环境稳定后自动恢复；每次操作前都会创建撤销快照" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="打开日志文件夹" Margin="0,0,9,0" Click="OpenLogFolder_Click" />
          <Button Content="重新检测" Style="{StaticResource PrimaryButtonStyle}" Click="Refresh_Click" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.18*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="0.82*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource SectionCardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="148" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="126" Height="102" VerticalAlignment="Center">
              <Border Width="124" Height="76" VerticalAlignment="Top" CornerRadius="7" BorderThickness="6" BorderBrush="#273247" Background="#183A66">
                <Grid ClipToBounds="True">
                  <Ellipse Width="75" Height="75" Fill="#5D99F7" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Rectangle Height="8" Fill="#E9EEF7" Opacity="0.9" VerticalAlignment="Bottom" />
                </Grid>
              </Border>
              <Rectangle Width="9" Height="23" Fill="#3F4B60" VerticalAlignment="Bottom" />
              <Rectangle Width="54" Height="5" RadiusX="2" RadiusY="2" Fill="#3F4B60" VerticalAlignment="Bottom" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="LiveStatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="EnvironmentBadgeText" Text="正在检测" Foreground="{StaticResource SuccessBrush}" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="CurrentDisplayNameText" Text="读取显示器信息…" Margin="0,6,0,10" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
              <WrapPanel>
                <TextBlock x:Name="ResolutionText" Text="—" Margin="0,0,16,5" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="ScaleText" Text="—" Margin="0,0,16,5" Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="DisplayTypeText" Text="—" Margin="0,0,16,5" Foreground="{StaticResource SecondaryTextBrush}" />
              </WrapPanel>
              <TextBlock x:Name="OutputText" Text="—" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
              <TextBlock x:Name="LayoutStatusText" Text="尚未检查布局方案" Margin="0,12,0,9" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
              <WrapPanel>
                <Button x:Name="SaveLayoutButton" Content="保存当前布局" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,9,0" Click="SaveLayout_Click" />
                <Button x:Name="RestoreLayoutButton" Content="恢复已保存布局" IsEnabled="False" Margin="0,0,9,0" Click="RestoreLayout_Click" />
                <Button x:Name="UndoLastRestoreButton" Content="撤销最近恢复" IsEnabled="False" Click="UndoLastRestore_Click" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}">
                <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource PrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="诊断记录" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="TimestampText" Text="尚未采集" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="1" x:Name="StatusText" Text="正在等待第一次检测…" Margin="0,15,0,12" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
            <StackPanel Grid.Row="2">
              <Button Content="复制完整诊断信息" HorizontalAlignment="Stretch" Click="CopyReport_Click" />
              <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,12" />
              <CheckBox x:Name="StartWithWindowsCheckBox"
                        Content="登录 Windows 后自动运行"
                        Foreground="{StaticResource TextBrush}"
                        Margin="2,0,0,9"
                        Checked="StartWithWindows_Changed"
                        Unchecked="StartWithWindows_Changed" />
              <CheckBox x:Name="ShowNotificationsCheckBox"
                        Content="恢复成功时显示通知"
                        Foreground="{StaticResource TextBrush}"
                        Margin="2,0,0,0"
                        Checked="ShowNotifications_Changed"
                        Unchecked="ShowNotifications_Changed" />
              <TextBlock Text="失败始终提醒；成功通知默认关闭"
                         FontSize="10.5"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="22,6,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="4" Style="{StaticResource SectionCardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Margin="22,17,22,15">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="采集详情" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="设备路径可以帮助判断 UU 虚拟屏标识是否稳定" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="IdentityText" Text="配置标识：—" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
          </Grid>

          <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBox x:Name="DetailsText"
                     Text="正在读取…"
                     Padding="22,16"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{StaticResource TextBrush}"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="12"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="ProfilesPanel" Grid.Column="1" Margin="30,25,32,28" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="显示方案" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="用纯桌面预览快速辨认每套布局；旧方案重新保存后会自动生成预览" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新方案" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Click="RefreshProfiles_Click" />
      </Grid>

      <Grid Grid.Row="2">
        <TextBlock x:Name="ProfilesEmptyText"
                   Text="还没有保存过显示方案。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="15" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="ProfilesItemsControl">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,14,14" Padding="0" ClipToBounds="True">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="188" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Background="#E8EDF6">
                      <TextBlock Text="暂无预览&#x0a;重新保存此方案后自动生成"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource SecondaryTextBrush}" />
                      <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="9,5" CornerRadius="8" Background="#D9000000">
                        <TextBlock Text="{Binding CurrentBadge}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="18,15,18,18">
                      <TextBox Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               BorderBrush="{StaticResource BorderBrush}"
                               Padding="8,6" />
                      <TextBlock Text="{Binding DisplaySummary}" Margin="0,10,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding LayoutSummary}" Margin="0,5,0,12" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                      <WrapPanel>
                        <Button Content="恢复" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Tag="{Binding}" IsEnabled="{Binding CanRestore}" Click="RestoreProfileCard_Click" />
                        <Button Content="保存名称" Margin="0,0,8,0" Tag="{Binding}" Click="RenameProfileCard_Click" />
                        <Button Content="删除" Tag="{Binding}" Click="DeleteProfileCard_Click" />
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="HistoryPanel" Grid.Column="1" Margin="30,25,32,28" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="恢复记录" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="每次覆盖保存前都会保留旧版本；恢复后确认无误，再保存为当前方案" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新记录" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Click="RefreshHistory_Click" />
      </Grid>

      <Grid Grid.Row="2">
        <TextBlock x:Name="HistoryEmptyText"
                   Text="暂无历史记录。第二次保存同一方案时会自动产生记录。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="15" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="HistoryItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,12" Padding="14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="210" />
                      <ColumnDefinition Width="18" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="118" CornerRadius="9" Background="#E8EDF6" ClipToBounds="True">
                      <Grid>
                        <TextBlock Text="此旧版本没有预览"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ProfileName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="{Binding SavedAt}" Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding DisplaySummary}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding LayoutSummary}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="3"
                            Content="临时恢复"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Tag="{Binding}"
                            IsEnabled="{Binding CanRestore}"
                            VerticalAlignment="Center"
                            Click="RestoreHistoryCard_Click" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
