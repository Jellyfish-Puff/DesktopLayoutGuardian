<Window x:Class="DesktopLayoutGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面布局 - 显示环境保护"
        Icon="Assets/AppIcon.ico"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16,24,16,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="38" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8,0">
          <Image Width="38" Height="38" Source="Assets/AppIcon.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="桌面布局" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock Text="显示环境保护 · v1.0.0" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <Button x:Name="CurrentEnvironmentNavButton" Style="{StaticResource NavButtonStyle}" Background="{StaticResource PrimarySoftBrush}" Foreground="{StaticResource PrimaryBrush}" Click="NavigateCurrent_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="29" />
              <TextBlock Text="概览" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ProfilesNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateProfiles_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="29" />
              <TextBlock Text="显示方案" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="HistoryNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateHistory_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="29" />
              <TextBlock Text="恢复记录" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavigateSettings_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="17" Width="29" />
              <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border x:Name="ProtectionStatusBorder" Grid.Row="3" Padding="11" CornerRadius="10" Background="#DFF5EB">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ProtectionStatusIcon" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
            <StackPanel Margin="9,0,0,0">
              <TextBlock x:Name="ProtectionStatusTitle" Text="后台保护已开启" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
              <TextBlock x:Name="ProtectionStatusSubtitle" Text="仅恢复已保存的方案" FontSize="11" Foreground="#477363" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="CurrentEnvironmentPanel" Grid.Column="1" Margin="40,30,40,30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="22" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="GreetingText" Text="你好" FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock x:Name="OverviewSubtitleText" Text="正在识别当前显示环境…" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <CheckBox Grid.Column="1"
                  Content="自动恢复"
                  Style="{StaticResource SwitchCheckBoxStyle}"
                  IsChecked="{Binding IsChecked, ElementName=AutoRestoreCheckBox, Mode=TwoWay}"
                  VerticalAlignment="Center" />
      </Grid>

      <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="30,26">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Grid Width="300" Height="210" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="286" Height="170" VerticalAlignment="Top" CornerRadius="12" BorderThickness="8" BorderBrush="#263246" Background="#183A66">
              <Grid ClipToBounds="True">
                <Ellipse Width="150" Height="150" Fill="#6EA2FF" Opacity="0.42" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Ellipse.Effect>
                    <BlurEffect Radius="18" />
                  </Ellipse.Effect>
                </Ellipse>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,18,0,0">
                  <Rectangle Width="10" Height="15" RadiusX="2" Fill="#E8F0FF" Margin="0,0,12,0" />
                  <Rectangle Width="10" Height="15" RadiusX="2" Fill="#E8F0FF" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0">
                  <Rectangle Width="10" Height="15" RadiusX="2" Fill="#E8F0FF" />
                </StackPanel>
                <Rectangle Height="13" Fill="#DAE5F6" Opacity="0.95" VerticalAlignment="Bottom" />
              </Grid>
            </Border>
            <Rectangle Width="12" Height="34" Fill="#4A5363" VerticalAlignment="Bottom" Margin="0,0,0,8" />
            <Rectangle Width="92" Height="7" RadiusX="3" RadiusY="3" Fill="#4A5363" VerticalAlignment="Bottom" />
          </Grid>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="LiveStatusDot" Width="9" Height="9" Fill="{StaticResource PrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock x:Name="EnvironmentBadgeText" Text="正在检测" Foreground="{StaticResource PrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="CurrentDisplayNameText" Text="读取显示器信息…" Margin="0,8,0,12" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
            <WrapPanel>
              <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,7,0" />
              <TextBlock x:Name="ResolutionText" Text="—" Margin="0,0,18,6" Foreground="{StaticResource SecondaryTextBrush}" />
              <TextBlock Text="&#xE71E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,7,0" />
              <TextBlock x:Name="ScaleText" Text="—" Margin="0,0,18,6" Foreground="{StaticResource SecondaryTextBrush}" />
              <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,7,0" />
              <TextBlock x:Name="DisplayTypeText" Text="—" Margin="0,0,16,6" Foreground="{StaticResource SecondaryTextBrush}" />
            </WrapPanel>
            <TextBlock x:Name="OutputText" Text="—" Margin="0,2,0,12" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" />

            <Border Padding="0,0,0,0" Margin="0,0,0,5">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="OverviewStatusIcon" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource SuccessBrush}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Top" />
                <TextBlock x:Name="StatusText" Text="正在等待第一次检测…" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" MaxWidth="450" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="LayoutStatusText" Text="尚未检查布局方案" Margin="23,0,0,14" FontSize="11.5" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="450" />

            <WrapPanel>
              <Button x:Name="SaveLayoutButton" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,8" Click="SaveLayout_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0" />
                  <TextBlock Text="更新当前布局" />
                </StackPanel>
              </Button>
              <Button x:Name="RestoreLayoutButton" IsEnabled="False" Margin="0,0,10,8" Click="RestoreLayout_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0" />
                  <TextBlock Text="立即恢复" />
                </StackPanel>
              </Button>
              <Button x:Name="UndoLastRestoreButton" Content="撤销" IsEnabled="False" Margin="0,0,0,8" Click="UndoLastRestore_Click" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="已保存的显示方案" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="切换显示器后，将自动选用匹配的布局" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="管理方案  ›" Background="Transparent" BorderThickness="0" Click="NavigateProfiles_Click" />
      </Grid>

      <Grid Grid.Row="6">
        <TextBlock x:Name="OverviewProfilesEmptyText"
                   Text="还没有保存过显示方案，点击“更新当前布局”即可创建第一套方案。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="OverviewProfilesItemsControl">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="260" Height="160" VerticalAlignment="Top" Margin="0,0,14,0" Style="{StaticResource SectionCardStyle}" Padding="0" ClipToBounds="True">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="92" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Background="#E7ECF5">
                      <TextBlock Text="暂无预览" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                      <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9" Padding="8,4" CornerRadius="7" Background="#D9172033">
                        <TextBlock Text="{Binding CurrentBadge}" Foreground="White" FontSize="10.5" />
                      </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="14,11,14,12">
                      <TextBlock Text="{Binding EditableName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DisplaySummary}" Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="ProfilesPanel" Grid.Column="1" Margin="40,30,40,30" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="22" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="显示方案" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="用纯桌面预览快速辨认每套布局；旧方案重新保存后会自动生成预览" Margin="0,6,0,0" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新方案" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Click="RefreshProfiles_Click" />
      </Grid>

      <Grid Grid.Row="2">
        <TextBlock x:Name="ProfilesEmptyText"
                   Text="还没有保存过显示方案。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="15" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="ProfilesItemsControl">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Height="430" VerticalAlignment="Top" Style="{StaticResource SectionCardStyle}" Margin="0,0,14,14" Padding="0" ClipToBounds="True">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="196" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Background="#E8EDF6">
                      <TextBlock Text="暂无预览&#x0a;重新保存此方案后自动生成"
                                 TextAlignment="Center"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource SecondaryTextBrush}" />
                      <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="9,5" CornerRadius="8" Background="#D9000000">
                        <TextBlock Text="{Binding CurrentBadge}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="20,17,20,20">
                      <TextBox Text="{Binding EditableName, UpdateSourceTrigger=PropertyChanged}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               BorderBrush="{StaticResource BorderBrush}"
                               Padding="10,8" />
                      <TextBlock Text="{Binding DisplaySummary}" Margin="0,10,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding LayoutSummary}" Margin="0,5,0,12" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                      <WrapPanel>
                        <Button Content="恢复" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Tag="{Binding}" IsEnabled="{Binding CanRestore}" Click="RestoreProfileCard_Click" />
                        <Button Content="保存名称" Margin="0,0,8,0" Tag="{Binding}" Click="RenameProfileCard_Click" />
                        <Button Content="删除" Tag="{Binding}" Click="DeleteProfileCard_Click" />
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="HistoryPanel" Grid.Column="1" Margin="40,30,40,30" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="22" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="恢复记录" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock Text="每次覆盖保存前都会保留旧版本；恢复后确认无误，再保存为当前方案" Margin="0,6,0,0" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Content="刷新记录" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Center" Click="RefreshHistory_Click" />
      </Grid>

      <Grid Grid.Row="2">
        <TextBlock x:Name="HistoryEmptyText"
                   Text="暂无历史记录。第二次保存同一方案时会自动产生记录。"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   FontSize="15" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="HistoryItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14" Padding="16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="20" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="124" CornerRadius="11" Background="#E8EDF6" ClipToBounds="True">
                      <Grid>
                        <TextBlock Text="此旧版本没有预览"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ProfileName}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                      <TextBlock Text="{Binding SavedAt}" Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding DisplaySummary}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                      <TextBlock Text="{Binding LayoutSummary}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="3"
                            Content="临时恢复"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Tag="{Binding}"
                            IsEnabled="{Binding CanRestore}"
                            VerticalAlignment="Center"
                            Click="RestoreHistoryCard_Click" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="SettingsPanel" Grid.Column="1" Margin="40,30,40,30" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="22" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="设置" FontSize="29" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
        <TextBlock Text="控制后台行为、显示切换检测和本地数据；安全快照始终开启" Margin="0,6,0,0" FontSize="13.5" Foreground="{StaticResource SecondaryTextBrush}" />
      </StackPanel>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Style="{StaticResource SectionCardStyle}">
            <StackPanel>
              <TextBlock Text="常规" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="程序关闭主窗口后会继续在系统托盘运行" Margin="0,4,0,18" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
              <CheckBox x:Name="StartWithWindowsCheckBox"
                        Content="登录 Windows 后自动运行"
                        Foreground="{StaticResource TextBrush}"
                        Margin="2,0,0,13"
                        Checked="StartWithWindows_Changed"
                        Unchecked="StartWithWindows_Changed" />
              <CheckBox x:Name="ShowNotificationsCheckBox"
                        Content="恢复成功时显示通知"
                        Foreground="{StaticResource TextBrush}"
                        Margin="2,0,0,0"
                        Checked="SettingsControl_Changed"
                        Unchecked="SettingsControl_Changed" />
              <TextBlock Text="失败通知始终显示；安全快照始终开启"
                         FontSize="10.5"
                         Foreground="{StaticResource SecondaryTextBrush}"
                         Margin="22,7,0,0" />
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource SectionCardStyle}">
            <StackPanel>
              <TextBlock Text="自动恢复" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="关闭后仍会识别显示环境，但不会自动移动图标" Margin="0,4,0,16" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
              <CheckBox x:Name="AutoRestoreCheckBox"
                        Content="显示环境变化后自动恢复"
                        Style="{StaticResource SwitchCheckBoxStyle}"
                        Margin="2,0,0,15"
                        Checked="AutoRestore_Changed"
                        Unchecked="AutoRestore_Changed" />
              <TextBlock Text="检测策略" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <ComboBox x:Name="DetectionStrategyComboBox"
                        Padding="9,7"
                        SelectionChanged="DetectionStrategy_Changed">
                <ComboBoxItem Tag="Fast">快速（约 2 秒）</ComboBoxItem>
                <ComboBoxItem Tag="Standard">标准（约 4 秒，推荐）</ComboBoxItem>
                <ComboBoxItem Tag="Stable">稳健（约 6–7 秒）</ComboBoxItem>
              </ComboBox>
              <TextBlock x:Name="DetectionStrategyDescriptionText"
                         Text="适合实体屏与 UU 超级屏的日常使用"
                         Margin="0,7,0,13"
                         FontSize="10.5"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}" />
              <Button Content="立即重新检测" HorizontalAlignment="Left" Click="RefreshFromSettings_Click" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}">
            <StackPanel>
              <TextBlock Text="历史与安全" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="每个方案保留的旧版本数量" Margin="0,14,0,6" Foreground="{StaticResource TextBrush}" />
              <ComboBox x:Name="HistoryRetentionComboBox"
                        Padding="9,7"
                        SelectionChanged="HistoryRetention_Changed">
                <ComboBoxItem Tag="5">5 份</ComboBoxItem>
                <ComboBoxItem Tag="10">10 份（推荐）</ComboBoxItem>
                <ComboBoxItem Tag="20">20 份</ComboBoxItem>
                <ComboBoxItem Tag="50">50 份</ComboBoxItem>
              </ComboBox>
              <WrapPanel Margin="0,16,0,0">
                <Button Content="清理旧数据" Margin="0,0,8,8" Click="CleanupData_Click" />
                <Button Content="打开数据文件夹" Margin="0,0,8,8" Click="OpenDataFolder_Click" />
              </WrapPanel>
              <Button Content="安全清空全部方案"
                      HorizontalAlignment="Left"
                      Margin="0,4,0,0"
                      Foreground="#B42318"
                      Click="ResetAllProfiles_Click" />
              <TextBlock Text="清空时方案会移入 deleted 备份目录，不会立即永久删除"
                         Margin="0,8,0,0"
                         FontSize="10.5"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SectionCardStyle}">
            <StackPanel>
              <TextBlock Text="诊断与关于" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="出现显示切换问题时，可复制诊断信息用于排查" Margin="0,4,0,16" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
              <WrapPanel>
                <Button Content="复制诊断信息" Margin="0,0,8,8" Click="CopyReport_Click" />
                <Button Content="打开日志文件夹" Margin="0,0,8,8" Click="OpenLogFolder_Click" />
                <Button Content="清理旧日志" Margin="0,0,8,8" Click="ClearLogs_Click" />
              </WrapPanel>
              <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,14" />
              <TextBlock Text="DesktopLayoutGuardian v1.0.0" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
              <TextBlock Text="Windows 11 单显示器桌面布局保护工具" Margin="0,4,0,12" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
              <Button Content="打开 GitHub 项目" HorizontalAlignment="Left" Click="OpenProjectPage_Click" />
            </StackPanel>
          </Border>

          <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource SectionCardStyle}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="180" />
              </Grid.RowDefinitions>
              <Grid Margin="24,18,24,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="高级诊断" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                  <TextBlock x:Name="TimestampText" Text="尚未采集" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="IdentityText" Text="配置标识：—" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" />
              </Grid>
              <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />
              <TextBox Grid.Row="2"
                       x:Name="DetailsText"
                       Text="正在读取…"
                       Padding="24,16"
                       BorderThickness="0"
                       Background="Transparent"
                       Foreground="{StaticResource TextBrush}"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="11.5"
                       IsReadOnly="True"
                       VerticalScrollBarVisibility="Auto"
                       TextWrapping="Wrap"
                       AcceptsReturn="True" />
            </Grid>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
